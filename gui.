            }
            QSpinBox {
                background-color: #363b4e;
                border: 1px solid #5f698c;
                border-radius: 4px;
                padding: 3px 6px;
                font-size: 12px;
                font-weight: bold;
            }
        )");

        QVBoxLayout *mainLayout = new QVBoxLayout(this);
        mainLayout->setContentsMargins(0, 0, 0, 0);
        mainLayout->setSpacing(0);

        QWidget *topPanel = new QWidget();
        QVBoxLayout *panelLayout = new QVBoxLayout(topPanel);
        panelLayout->setContentsMargins(12, 10, 12, 8);
        panelLayout->setSpacing(8);

        QHBoxLayout *row1 = new QHBoxLayout();
        const char *labels[] = {"BFS (B)", "DFS (D)", "Dijkstra (J)", "A* (A)"};
        for (int i = 0; i < 4; i++)
        {
            algoBtns[i] = new QPushButton(labels[i]);
            algoBtns[i]->setFocusPolicy(Qt::NoFocus);
            connect(algoBtns[i], &QPushButton::clicked, [this, i]() {
                canvas->runAlgorithm(i);
            });
            row1->addWidget(algoBtns[i]);
        }

        speedLabel = new QLabel();
        speedLabel->setStyleSheet("font-size: 13px; font-weight: bold; margin-left: 10px;");
        row1->addWidget(speedLabel);
        row1->addStretch();
        panelLayout->addLayout(row1);

        QHBoxLayout *row2 = new QHBoxLayout();
        QPushButton *clearPathBtn = new QPushButton("Clear Path (R)");
        QPushButton *clearWallsBtn = new QPushButton("Clear Walls (C)");
        QPushButton *randWallsBtn = new QPushButton("Rand Walls (M)");
        pauseBtn = new QPushButton("Pause (Space)");
        QPushButton *slowerBtn = new QPushButton("Slower");
        QPushButton *fasterBtn = new QPushButton("Faster");

        QPushButton *toolBtns[] = {clearPathBtn, clearWallsBtn, randWallsBtn, pauseBtn, slowerBtn, fasterBtn};
        for (QPushButton *b : toolBtns)
        {
            b->setFocusPolicy(Qt::NoFocus);
            row2->addWidget(b);
        }
        panelLayout->addLayout(row2);

        QHBoxLayout *row3 = new QHBoxLayout();
        brushBtn = new QPushButton("Brush: Wall (T)");
        brushBtn->setFocusPolicy(Qt::NoFocus);

        QLabel *costText = new QLabel("Terrain Cost:");
        costText->setStyleSheet("font-size: 12px; font-weight: bold;");

        costSpin = new QSpinBox();
        costSpin->setRange(MIN_COST, MAX_COST);
        costSpin->setValue(5);
        costSpin->setFocusPolicy(Qt::NoFocus);

        QPushButton *randTerrainBtn = new QPushButton("Rand Terrain (N)");
        QPushButton *clearTerrainBtn = new QPushButton("Clear Terrain (X)");
        randTerrainBtn->setFocusPolicy(Qt::NoFocus);
        clearTerrainBtn->setFocusPolicy(Qt::NoFocus);

        row3->addWidget(brushBtn);
        row3->addWidget(costText);
        row3->addWidget(costSpin);
        row3->addWidget(randTerrainBtn);
        row3->addWidget(clearTerrainBtn);
        row3->addStretch();
        panelLayout->addLayout(row3);

        connect(clearPathBtn, &QPushButton::clicked, [this]() { canvas->clearSearch(); });
        connect(clearWallsBtn, &QPushButton::clicked, [this]() { canvas->clearWalls(); });
        connect(randWallsBtn, &QPushButton::clicked, [this]() { canvas->randomWalls(); });
        connect(pauseBtn, &QPushButton::clicked, [this]() { togglePause(); });
        connect(slowerBtn, &QPushButton::clicked, [this]() { changeSpeed(-1); });
        connect(fasterBtn, &QPushButton::clicked, [this]() { changeSpeed(1); });
        connect(brushBtn, &QPushButton::clicked, [this]() { toggleBrush(); });
        connect(costSpin, QOverload<int>::of(&QSpinBox::valueChanged), [this](int val) {
            canvas->brushCost = val;
        });
        connect(randTerrainBtn, &QPushButton::clicked, [this]() { canvas->randomTerrain(); });
        connect(clearTerrainBtn, &QPushButton::clicked, [this]() { canvas->clearTerrain(); });

        QLabel *hintLabel = new QLabel("Left drag: paint wall/terrain   Right drag: erase   Drag S/E: move start/end");
        hintLabel->setStyleSheet("color: #a0a8be; font-size: 11px;");
        panelLayout->addWidget(hintLabel);

        mainLayout->addWidget(topPanel);

        canvas = new GridCanvas();
        canvas->onStateChanged = [this]() { refreshUI(); };
        mainLayout->addWidget(canvas, 0, Qt::AlignCenter);

        statusLabel = new QLabel();
        statusLabel->setStyleSheet("background-color: #242732; padding: 10px 12px; font-size: 13px; font-weight: bold;");
        mainLayout->addWidget(statusLabel);

        setFixedSize(sizeHint());

        elapsed.start();
        timer = new QTimer(this);
        connect(timer, &QTimer::timeout, [this]() {
            float dt = elapsed.restart() / 1000.0f;
            canvas->updateAnimation(dt);
        });
        timer->start(16);

        refreshUI();
    }

protected:
    void keyPressEvent(QKeyEvent *event) override
    {
        switch (event->key())
        {
        case Qt::Key_B:     canvas->runAlgorithm(0); break;
        case Qt::Key_D:     canvas->runAlgorithm(1); break;
        case Qt::Key_J:     canvas->runAlgorithm(2); break;
        case Qt::Key_A:     canvas->runAlgorithm(3); break;
        case Qt::Key_R:     canvas->clearSearch(); break;
        case Qt::Key_C:     canvas->clearWalls(); break;
        case Qt::Key_M:     canvas->randomWalls(); break;
        case Qt::Key_N:     canvas->randomTerrain(); break;
        case Qt::Key_X:     canvas->clearTerrain(); break;
        case Qt::Key_T:     toggleBrush(); break;
        case Qt::Key_Space: togglePause(); break;
        case Qt::Key_Up:    changeSpeed(1); break;
        case Qt::Key_Down:  changeSpeed(-1); break;
        default:            QWidget::keyPressEvent(event);
        }
    }

private:
    void togglePause()
    {
        canvas->paused = !canvas->paused;
        refreshUI();
    }

    void toggleBrush()
    {
        canvas->terrainBrushActive = !canvas->terrainBrushActive;
        refreshUI();
    }

    void changeSpeed(int delta)
    {
        int next = canvas->speedIdx + delta;
        if (next >= 0 && next < SPEED_COUNT)
        {
            canvas->speedIdx = next;
            refreshUI();
        }
    }

    void refreshUI()
    {
        for (int i = 0; i < 4; i++)
        {
            bool isActive = (canvas->algoIdx == i);
            algoBtns[i]->setProperty("active", isActive);
            algoBtns[i]->style()->unpolish(algoBtns[i]);
            algoBtns[i]->style()->polish(algoBtns[i]);
        }

        pauseBtn->setText(canvas->paused ? "Resume (Space)" : "Pause (Space)");
        pauseBtn->setProperty("active", canvas->paused);
        pauseBtn->style()->unpolish(pauseBtn);
        pauseBtn->style()->polish(pauseBtn);

        brushBtn->setText(canvas->terrainBrushActive ? "Brush: Terrain (T)" : "Brush: Wall (T)");
        brushBtn->setProperty("active", canvas->terrainBrushActive);
        brushBtn->style()->unpolish(brushBtn);
        brushBtn->style()->polish(brushBtn);

        speedLabel->setText(QString("Speed: %1 nodes/s").arg(SPEEDS[canvas->speedIdx]));

        int visited = (int)canvas->visitShown;
        if (visited > canvas->result.visitOrderCount)
            visited = canvas->result.visitOrderCount;

        if (canvas->mode == IDLE)
        {
            statusLabel->setText("Ready. Paint walls or terrain, then pick an algorithm.");
        }
        else if (canvas->mode == VISITING)
        {
            statusLabel->setText(QString("Running %1...   Visited: %2")
                                     .arg(ALGO_NAMES[canvas->algoIdx]).arg(visited));
        }
        else if (canvas->mode == PATHING)
        {
            statusLabel->setText(QString("%1: drawing path...   Visited: %2")
                                     .arg(ALGO_NAMES[canvas->algoIdx]).arg(visited));
        }
        else if (canvas->result.found)
        {
            statusLabel->setText(QString("%1: Found!   Steps: %2   Terrain Cost: %3   Visited: %4")
                                     .arg(ALGO_NAMES[canvas->algoIdx])
                                     .arg(canvas->result.pathLength)
                                     .arg(canvas->result.pathCost)
                                     .arg(canvas->result.visitedCount));
        }
        else
        {
            statusLabel->setText(QString("%1: No path found!   Visited: %2")
                                     .arg(ALGO_NAMES[canvas->algoIdx])
                                     .arg(canvas->result.visitedCount));
        }
    }
};

int main(int argc, char *argv[])
{
    srand((unsigned)time(nullptr));

    QApplication app(argc, argv);
    VisualizerWindow window;
    window.show();

    return app.exec();
}
